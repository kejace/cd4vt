def Gluck.Discrete.SideTangent.SideTangentAdmissible : {n : ℕ} → (ZMod n → ℝ) → Prop :=
fun {n} ρ =>
  (∀ (i : ZMod n), 0 < ρ i) ∧
    ((∃ r, ∀ (i : ZMod n), ρ i = r) ∨ Gluck.Discrete.DFV (Gluck.Discrete.SideTangent.radiusDifference ρ) 0)
structure Gluck.Discrete.SideTangent.IsSideTangentRealization {n : ℕ} [NeZero n] (ρ : ZMod n → ℝ) (P N C : ZMod n → ℂ) :
  Prop
number of parameters: 6
fields:
  Gluck.Discrete.SideTangent.IsSideTangentRealization.radius_pos : ∀ (i : ZMod n), 0 < ρ i
  Gluck.Discrete.SideTangent.IsSideTangentRealization.simple : Gluck.Discrete.IsSimplePolygon P
  Gluck.Discrete.SideTangent.IsSideTangentRealization.strict_convex : Gluck.Discrete.StrictConvexEdgeSupport P
  Gluck.Discrete.SideTangent.IsSideTangentRealization.unit_normal : ∀ (i : ZMod n), ‖N i‖ = 1
  Gluck.Discrete.SideTangent.IsSideTangentRealization.oriented_edge : ∀ (i : ZMod n),
      ∃ ℓ, 0 < ℓ ∧ P (i + 1) - P i = ℓ • (Complex.I * N i)
  Gluck.Discrete.SideTangent.IsSideTangentRealization.supporting : ∀ (i j : ZMod n), inner ℝ (N i) (P j - P i) ≤ 0
  Gluck.Discrete.SideTangent.IsSideTangentRealization.circles : ∀ (i : ZMod n),
      Gluck.Discrete.SideTangent.ThreeLineCircle P N i (C i) (ρ i)
  Gluck.Discrete.SideTangent.IsSideTangentRealization.unique_circle : ∀ (i : ZMod n) (D : ℂ) (r : ℝ),
      Gluck.Discrete.SideTangent.ThreeLineCircle P N i D r → D = C i ∧ r = ρ i
  Gluck.Discrete.SideTangent.IsSideTangentRealization.central_contact : ∀ (i : ZMod n),
      C i + ρ i • N i ∈ openSegment ℝ (P i) (P (i + 1))
constructor:
  Gluck.Discrete.SideTangent.IsSideTangentRealization.mk {n : ℕ} [NeZero n] {ρ : ZMod n → ℝ} {P N C : ZMod n → ℂ}
    (radius_pos : ∀ (i : ZMod n), 0 < ρ i) (simple : Gluck.Discrete.IsSimplePolygon P)
    (strict_convex : Gluck.Discrete.StrictConvexEdgeSupport P) (unit_normal : ∀ (i : ZMod n), ‖N i‖ = 1)
    (oriented_edge : ∀ (i : ZMod n), ∃ ℓ, 0 < ℓ ∧ P (i + 1) - P i = ℓ • (Complex.I * N i))
    (supporting : ∀ (i j : ZMod n), inner ℝ (N i) (P j - P i) ≤ 0)
    (circles : ∀ (i : ZMod n), Gluck.Discrete.SideTangent.ThreeLineCircle P N i (C i) (ρ i))
    (unique_circle :
      ∀ (i : ZMod n) (D : ℂ) (r : ℝ), Gluck.Discrete.SideTangent.ThreeLineCircle P N i D r → D = C i ∧ r = ρ i)
    (central_contact : ∀ (i : ZMod n), C i + ρ i • N i ∈ openSegment ℝ (P i) (P (i + 1))) :
    Gluck.Discrete.SideTangent.IsSideTangentRealization ρ P N C
Gluck.Discrete.SideTangent.sideTangentConverse {n : ℕ} [NeZero n] (hn : 4 ≤ n) (ρ : ZMod n → ℝ)
  (h : Gluck.Discrete.SideTangent.SideTangentAdmissible ρ) : Gluck.Discrete.SideTangent.RealizesSideTangent ρ
Gluck.Discrete.SideTangent.sideTangentConverse_of_dfv {n : ℕ} [NeZero n] (ρ : ZMod n → ℝ) (hρ : ∀ (i : ZMod n), 0 < ρ i)
  (h : Gluck.Discrete.DFV (Gluck.Discrete.SideTangent.radiusDifference ρ) 0) :
  Gluck.Discrete.SideTangent.RealizesSideTangent ρ
Gluck.Discrete.SideTangent.exists_sideTangent_scaledPolygon {n : ℕ} [NeZero n] (ρ : ZMod n → ℝ)
  (hρ : ∀ (i : ZMod n), 0 < ρ i) (h : Gluck.Discrete.DFV (Gluck.Discrete.SideTangent.radiusDifference ρ) 0) :
  ∃ U Y P,
    Gluck.Discrete.SideTangent.IsCyclicStrictTangentialFan U Y ∧
      (∀ (i : ZMod n), P (i + 1) - P i = ρ i • (Y (i + 1) - Y i)) ∧
        Gluck.Discrete.StrictConvexEdgeSupport P ∧ Gluck.Discrete.IsSimplePolygon P
Gluck.Discrete.SideTangent.IsSideTangentRealization.tangent_sphere {n : ℕ} [NeZero n] {ρ : ZMod n → ℝ}
  {P N C : ZMod n → ℂ} (h : Gluck.Discrete.SideTangent.IsSideTangentRealization ρ P N C) (i k : ZMod n)
  (hk : k = i - 1 ∨ k = i ∨ k = i + 1) :
  Metric.sphere (C i) (ρ i) ∩ Gluck.Discrete.SideTangent.supportingLine P N k = {C i + ρ i • N k}
